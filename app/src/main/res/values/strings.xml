    <!-- Screen help ("?" sheets) -->
    <string name="help_dice_title">How to roll dice</string>
    <string name="help_dice_button">How to use the dice roller</string>
    <string name="help_dice_add_title">Add dice</string>
    <string name="help_dice_add_text">Tap a die in the panel to add it to the formula. The badge on the die shows how many of it you have.</string>
    <string name="help_dice_remove_title">Remove dice</string>
    <string name="help_dice_remove_text">Long-press a die to remove one of it. Long-press dN to remove your custom dice. The eraser button clears the whole formula.</string>
    <string name="help_dice_custom_title">Custom dice (dN)</string>
    <string name="help_dice_custom_text">The first tap on dN asks for the number of sides (2–1000): type it, tap the arrows, or swipe up and down on the number. Further taps add the same die. Only one custom size at a time: to choose another, long-press dN until all are gone, or tap the eraser.</string>
    <string name="help_dice_modifier_title">Bonus</string>
    <string name="help_dice_modifier_text">−1 and +1 change the number added to the total, for example 2d6+3.</string>
    <string name="help_dice_formula_title">Formula</string>
    <string name="help_dice_formula_text">The ƒx button shows the formula field. You can type it too: 2d6+1d4+3, 4d6kh3 (roll 4, keep the highest 3), 2d20kl1 (keep the lowest).</string>
    <string name="help_dice_modes_title">Advantage and Disadvantage</string>
    <string name="help_dice_modes_text">When exactly one die is selected, Advantage rolls it twice and keeps the higher result; Disadvantage keeps the lower.</string>
    <string name="help_dice_roll_title">Roll</string>
    <string name="help_dice_roll_text">Swipe across the tray to throw the dice. A faster swipe tumbles longer, but never changes the result. With Quick roll on (Settings), tap the Roll button instead.</string>
    <string name="help_dice_results_title">Results</string>
    <string name="help_dice_results_text">The total is shown under the tray. Faded dice were dropped by kh or kl. The history button opens your recent rolls.</string>
    <string name="help_dice_panel_title">More room</string>
    <string name="help_dice_panel_text">The chevron under the panel hides or shows it, so the tray gets more space.</string>
    <string name="help_number_title">How to generate numbers</string>
    <string name="help_number_button">How to use the number generator</string>
    <string name="help_number_range_title">Range</string>
    <string name="help_number_range_text">Min and Max are both included, and negative numbers are allowed. Type a value, tap the ▲▼ arrows next to a field, or swipe up and down on it.</string>
    <string name="help_number_count_title">How many</string>
    <string name="help_number_count_text">Generate from 1 to 1000 numbers at once.</string>
    <string name="help_number_mode_title">Integer or Decimal</string>
    <string name="help_number_mode_text">Decimal mode gives numbers with 1–6 decimal places; set the places with − and +. For example, 0 to 1 with 2 places gives values like 0.07 or 1.00.</string>
    <string name="help_number_duplicates_title">Duplicates</string>
    <string name="help_number_duplicates_text">With Allow duplicates off, every number is different. The range then has to hold at least as many values as you ask for.</string>
    <string name="help_number_results_title">Results</string>
    <string name="help_number_results_text">One number is shown large; several are shown as chips with their sum. Copy puts them on the clipboard and Share sends them to another app. The history button lists recent results, and you can clear it there.</string>
    <string name="help_number_memory_title">Remembered</string>
    <string name="help_number_memory_text">Your last range, options and result are kept when you close the app.</string>
